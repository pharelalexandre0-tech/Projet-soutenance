# Adresse réelle du visiteur : dernière adresse de X-Forwarded-For, celle
# qu'a ajoutée la passerelle de l'hébergeur (un visiteur ne peut pas la
# falsifier, contrairement aux premières). Transmise au backend pour que la
# limite d'essais de connexion et le journal d'audit visent chaque visiteur,
# pas le relais nginx commun à tous.
map $http_x_forwarded_for $edusphere_client {
    "~(?<derniere>[^,\s]+)\s*$" $derniere;
    default $remote_addr;
}

server {
    listen ${PORT};
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # En-têtes de sécurité du site.
    #   - CSP : scripts uniquement servis par le site lui-même (aucun script
    #     externe ni en ligne), polices Google, API EduSphere, rien d'autre ;
    #     le site ne peut pas être affiché dans un cadre (clickjacking).
    #   - HSTS : HTTPS imposé pendant un an.
    #   - le navigateur ne devine pas les types de fichiers, n'envoie que
    #     l'origine comme référent, et l'appareil photo, le micro et la
    #     géolocalisation sont refusés.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: ${BACKEND_SCHEME}://${BACKEND_HOST}; connect-src 'self' ${BACKEND_SCHEME}://${BACKEND_HOST}; worker-src 'self'; manifest-src 'self'; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;

    # SPA React Router : toute route inconnue retombe sur index.html.
    location / {
        try_files $uri /index.html;
    }

    # Flux de mise à jour en direct (Server-Sent Events) : transmis sans
    # tampon et sans coupure après 60 s de silence (le serveur envoie un
    # battement toutes les 25 s).
    location = /api/evenements {
        proxy_pass ${BACKEND_SCHEME}://${BACKEND_HOST}/api/evenements;
        proxy_ssl_server_name on;
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header X-EduSphere-Client $edusphere_client;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location /api/ {
        # Défaut nginx (1m) trop bas pour un logo d'établissement envoyé en
        # base64 (~1,4x sa taille binaire, jusqu'à 1 Mo côté frontend) — sans
        # ça, nginx rejette la requête AVANT le backend (dont la limite à
        # lui, dans app.js, est déjà à 3mb) avec une page d'erreur HTML, pas
        # le JSON {erreur:...} que le frontend sait afficher : d'où un
        # "échec de la mise à jour" générique qui ne disait pas pourquoi.
        client_max_body_size 8m;
        proxy_pass ${BACKEND_SCHEME}://${BACKEND_HOST}/api/;
        proxy_ssl_server_name on;
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-EduSphere-Client $edusphere_client;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Bulletins et reçus PDF générés par le backend.
    location /fichiers/ {
        proxy_pass ${BACKEND_SCHEME}://${BACKEND_HOST}/fichiers/;
        proxy_ssl_server_name on;
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header X-EduSphere-Client $edusphere_client;
    }
}
