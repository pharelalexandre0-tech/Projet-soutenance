server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # SPA React Router : toute route inconnue retombe sur index.html.
    location / {
        try_files $uri /index.html;
    }

    # Flux de mise à jour en direct (Server-Sent Events) : transmis sans
    # tampon et sans coupure après 60 s de silence (le serveur envoie un
    # battement toutes les 25 s).
    location = /api/evenements {
        proxy_pass ${BACKEND_SCHEME}://${BACKEND_HOST}/api/evenements;
        proxy_ssl_server_name on;
        proxy_set_header Host ${BACKEND_HOST};
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location /api/ {
        # Défaut nginx (1m) trop bas pour un logo d'établissement envoyé en
        # base64 (~1,4x sa taille binaire, jusqu'à 1 Mo côté frontend) — sans
        # ça, nginx rejette la requête AVANT le backend (dont la limite à
        # lui, dans app.js, est déjà à 3mb) avec une page d'erreur HTML, pas
        # le JSON {erreur:...} que le frontend sait afficher : d'où un
        # "échec de la mise à jour" générique qui ne disait pas pourquoi.
        client_max_body_size 4m;
        proxy_pass ${BACKEND_SCHEME}://${BACKEND_HOST}/api/;
        proxy_ssl_server_name on;
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Bulletins et reçus PDF générés par le backend.
    location /fichiers/ {
        proxy_pass ${BACKEND_SCHEME}://${BACKEND_HOST}/fichiers/;
        proxy_ssl_server_name on;
        proxy_set_header Host ${BACKEND_HOST};
    }
}
