server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # SPA React Router : toute route inconnue retombe sur index.html.
    location / {
        try_files $uri /index.html;
    }

    location /api/ {
        proxy_pass ${BACKEND_SCHEME}://${BACKEND_HOST}/api/;
        proxy_ssl_server_name on;
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Bulletins et reçus PDF générés par le backend.
    location /fichiers/ {
        proxy_pass ${BACKEND_SCHEME}://${BACKEND_HOST}/fichiers/;
        proxy_ssl_server_name on;
        proxy_set_header Host ${BACKEND_HOST};
    }
}
