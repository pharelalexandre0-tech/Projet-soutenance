@startuml diagramme-08
title Diagramme 8 : encaissement d'un paiement et reçu
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #0B1E3D
skinparam roundcorner 8
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam sequenceParticipantBorderColor #0B1E3D
skinparam sequenceParticipantBackgroundColor #F7F9FC
skinparam sequenceLifeLineBorderColor #9AA3B5
skinparam sequenceGroupBorderColor #1D5FA8
autonumber
actor "Finance" as FI
boundary "Frais de scolarité" as UI
control "API /finance" as API
control "pdfService" as PDF
database "PostgreSQL" as DB
participant "Service e-mail" as MAIL
actor "Étudiant" as ET

FI -> UI : Encaisser (élève, montant, mode de paiement)
UI -> API : POST /api/finance/paiements
activate API
API -> DB : charger le frais et l'élève
API -> API : vérifier 0 < montant <= reste dû
alt montant invalide
  API --> UI : 400 montant incorrect
  UI --> FI : message d'erreur
else montant valide
  API -> DB : INSERT paiements
  API -> DB : UPDATE frais_scolarite\n(montantRegle, statut partiel ou soldé)
  API -> PDF : genererRecuPDF(numéro REC-AAAA-NNNNN)
  activate PDF
  PDF -> DB : INSERT documents_pdf
  PDF --> API : reçu (contenu + adresse)
  deactivate PDF
  API -> DB : INSERT recus
  API -> MAIL : reçu en pièce jointe
  MAIL -> ET : e-mail « Reçu de paiement »
  API -> DB : INSERT notifications
  API --> UI : 201 paiement + reçu
  UI --> FI : lien vers le reçu PDF
end
deactivate API
@enduml
