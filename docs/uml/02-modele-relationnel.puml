comptes_rendus_saisie }o--o| matieres : matiereId
comptes_rendus_saisie }o--o| professeurs : professeurId
eleves }o--o| classes : classeId
eleves }o--o| utilisateurs : compteEtudiantId
eleves }o--o| etablissements : etablissementId
eleves }o--o| utilisateurs : parentId
emplois_du_temps }o--o| classes : classeId
emplois_du_temps }o--o| semestres : semestreId
frais_scolarite }o--o| eleves : eleveId
frais_scolarite }o--o| semestres : semestreId
incidents_comportement }o--o| eleves : eleveId
incidents_comportement }o--o| utilisateurs : saisiParAcademieId
matieres }o--o| unites_enseignement : uniteEnseignementId
messages_annonces }o--o| utilisateurs : auteurId
messages_annonces }o--o| classes : classeId
notes }o--o| comptes_ephemeres : compteEphemereId
notes }o--o| eleves : eleveId
notes }o--o| matieres : matiereId
notes }o--o| utilisateurs : saisiParAcademieId
notifications }o--o| utilisateurs : utilisateurId
