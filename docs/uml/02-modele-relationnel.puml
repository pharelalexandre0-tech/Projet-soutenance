paiements }o--o| frais_scolarite : fraisId
personnel }o--o| etablissements : etablissementId
personnel }o--o| professeurs : professeurId
predictions_ia }o--o| eleves : eleveId
professeurs }o--o| etablissements : etablissementId
publications_emplois_du_temps }o--o| classes : classeId
publications_emplois_du_temps }o--o| utilisateurs : publieParId
publications_emplois_du_temps }o--o| semestres : semestreId
