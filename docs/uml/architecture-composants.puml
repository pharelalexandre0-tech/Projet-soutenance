@startuml architecture
title EduSphere : architecture logicielle (composants)
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #0B1E3D
skinparam roundcorner 8
skinparam componentBackgroundColor #F7F9FC
skinparam componentBorderColor #0B1E3D
skinparam packageBorderColor #9AA3B5

package "Frontend (React)" {
  [Espaces par rôle\n(Superadmin, Académie, Finance,\nÉtudiant, Parent)] as ESP
  [Page professeur\n(accès temporaire)] as PROF
  [Client API (axios)] as CLI
}
package "Backend (Express)" {
  [Routes et middlewares\n(authentification JWT, rôles,\nfonctionnalités, maintenance)] as ROUTES
  [Contrôleurs] as CTRL
  package "Services" {
    [moyenneService\n(règles LMD)] as MOY
    [riskService\n(régression logistique)] as IA
    [pdfService] as PDFS
    [emailService\n+ modèles d'e-mail] as MAILS
    [matriculeService] as MAT
    [emploiDuTempsService] as EDT
    [compteRenduService] as CR
  }
  [Modèles Sequelize] as MOD
}
database "PostgreSQL" as PG

ESP --> CLI
PROF --> CLI
CLI --> ROUTES : REST / JSON
ROUTES --> CTRL
CTRL --> MOY
CTRL --> IA
CTRL --> PDFS
CTRL --> MAILS
CTRL --> MAT
CTRL --> EDT
CTRL --> CR
CTRL --> MOD
MOY --> MOD
IA --> MOD
PDFS --> MOD : documents_pdf
MAILS --> MOD : journal_emails
MOD --> PG
@enduml
