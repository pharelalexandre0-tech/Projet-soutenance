PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/plateforme_scolaire
JWT_SECRET=change-moi-en-production
JWT_EXPIRES_IN=8h
EPHEMERE_LIEN_BASE_URL=http://localhost:5173/acces-temporaire

# Optionnel : sans aucune de ces variables, les e-mails sont simulés
# (console.log) au lieu d'être vraiment envoyés.
#
# SENDGRID_API_KEY est la voie recommandée en production, notamment sur
# Render (le SMTP sortant est bloqué sur son plan gratuit) : créez un
# compte gratuit sur sendgrid.com, Settings > Sender Authentication >
# Single Sender Verification, vérifiez UNE adresse (clic sur le lien reçu
# par mail, ~2 min, aucun domaine ni DNS requis) — une fois vérifiée, elle
# peut envoyer vers n'importe quel destinataire réel, sans restriction.
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM=votre.adresse@gmail.com

# RESEND_API_KEY reste utilisable (repli après SendGrid) : créez un compte
# gratuit sur resend.com, récupérez une clé API — mais sans domaine
# vérifié, l'envoi ne fonctionne que vers votre propre adresse e-mail
# (alias +xxx compris, Resend les refuse aussi).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=EduSphere <onboarding@resend.dev>

# SMTP reste utilisable en dev local (le SMTP sortant n'y est pas bloqué),
# et RESEND_API_KEY est prioritaire dessus si les deux sont présents. Avec
# un compte Gmail, activez la validation en 2 étapes puis générez un
# "mot de passe d'application" (myaccount.google.com/apppasswords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre.adresse@gmail.com
SMTP_PASS=mot-de-passe-application-16-caracteres
SMTP_FROM=EduSphere <votre.adresse@gmail.com>

# Premier compte d'une installation neuve (npm run init:superadmin).
# SUPERADMIN_EMAIL=vous@exemple.com
# SUPERADMIN_MOT_DE_PASSE=un-mot-de-passe-solide
# SUPERADMIN_PRENOM=Prénom
# SUPERADMIN_NOM=Nom

# Mot de passe des comptes Académie et Finance de l'école de démonstration
# (npm run seed:demo).
# DEMO_MOT_DE_PASSE=un-mot-de-passe-de-demo

# RECOMMANDÉ contre les courriers indésirables : envoi par l'API Gmail
# (HTTPS, fonctionne sur Render). Le message part des serveurs de Google au
# nom de votre adresse Gmail, donc authentifié (SPF, DKIM, DMARC valides),
# contrairement à SendGrid ou Resend avec une adresse @gmail.com.
# Prioritaire sur SendGrid, Resend et SMTP quand les quatre sont renseignés.
# Mise en place (une fois, environ 15 minutes) :
#  1. console.cloud.google.com : créer un projet, activer « Gmail API ».
#  2. Écran de consentement OAuth : type Externe, ajouter votre adresse
#     comme utilisateur test, puis PUBLIER l'application (sinon le jeton
#     expire au bout de 7 jours).
#  3. Identifiants > Créer un ID client OAuth > Application Web, URI de
#     redirection autorisé : https://developers.google.com/oauthplayground
#  4. developers.google.com/oauthplayground : roue dentée > « Use your own
#     OAuth credentials » (ID et secret ci-dessus), portée
#     https://www.googleapis.com/auth/gmail.send, autoriser avec votre
#     compte Gmail, puis « Exchange authorization code for tokens » :
#     copier le Refresh token.
# GMAIL_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=xxxxxxxx
# GMAIL_REFRESH_TOKEN=1//xxxxxxxx
# GMAIL_FROM=votre.adresse@gmail.com
