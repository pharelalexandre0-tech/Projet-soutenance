PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/plateforme_scolaire
JWT_SECRET=change-moi-en-production
JWT_EXPIRES_IN=8h
EPHEMERE_LIEN_BASE_URL=http://localhost:5173/acces-temporaire

# Optionnel : sans ces 3 variables, les e-mails sont simulés (console.log)
# au lieu d'être vraiment envoyés. Avec un compte Gmail, activez la
# validation en 2 étapes puis générez un "mot de passe d'application"
# (myaccount.google.com/apppasswords) à mettre dans SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre.adresse@gmail.com
SMTP_PASS=mot-de-passe-application-16-caracteres
SMTP_FROM=EduSphere <votre.adresse@gmail.com>
