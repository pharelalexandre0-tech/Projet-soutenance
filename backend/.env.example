PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/plateforme_scolaire
JWT_SECRET=change-moi-en-production
JWT_EXPIRES_IN=8h
EPHEMERE_LIEN_BASE_URL=http://localhost:5173/acces-temporaire

# Optionnel : sans aucune de ces variables, les e-mails sont simulés
# (console.log) au lieu d'être vraiment envoyés.
#
# BREVO_API_KEY est la voie recommandée en production (API HTTPS, donc
# compatible avec Render, qui bloque le SMTP sortant sur son plan gratuit).
# Compte gratuit sur brevo.com (300 e-mails par jour), puis :
#  1. Expéditeurs, domaines et IP dédiées > Expéditeurs > Ajouter un
#     expéditeur : votre adresse, validée par le code reçu par e-mail.
#     Avec une adresse @gmail.com, Brevo envoie sous son domaine
#     authentifié (@brevosend.com) : les messages passent les contrôles
#     anti-spam ; le nom affiché reste celui de l'école.
#  2. SMTP et API > Clés API > Générer une nouvelle clé (clé v3, xkeysib-).
#  3. Sécurité > IP autorisées : désactiver le blocage des IP inconnues
#     (les adresses de sortie de Render changent).
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxx
BREVO_FROM=votre.adresse@gmail.com

# SENDGRID_API_KEY reste utilisable en repli après Brevo : Settings >
# Sender Authentication > Single Sender Verification.
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM=votre.adresse@gmail.com

# SMTP reste utilisable en dev local (le SMTP sortant n'y est pas bloqué),
# après Brevo et SendGrid s'ils sont configurés. Avec
# un compte Gmail, activez la validation en 2 étapes puis générez un
# "mot de passe d'application" (myaccount.google.com/apppasswords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre.adresse@gmail.com
SMTP_PASS=mot-de-passe-application-16-caracteres
SMTP_FROM=EduSphere <votre.adresse@gmail.com>

# Premier compte d'une installation neuve (npm run init:superadmin).
# SUPERADMIN_EMAIL=vous@exemple.com
# SUPERADMIN_MOT_DE_PASSE=un-mot-de-passe-solide
# SUPERADMIN_PRENOM=Prénom
# SUPERADMIN_NOM=Nom

# Mot de passe des comptes Académie et Finance de l'école de démonstration
# (npm run seed:demo).
# DEMO_MOT_DE_PASSE=un-mot-de-passe-de-demo
